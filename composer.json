{
    "name": "linkrobins/markdown-widget",
    "description": "Markdown widget for fof/forum-widgets-core",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "widget",
        "markdown",
        "forum-widgets"
    ],
    "support": {
        "issues": "https://github.com/linkrobins/markdown-widget/issues",
        "source": "https://github.com/linkrobins/markdown-widget"
    },
    "homepage": "https://linkrobins.com/extensions/markdown-widget",
    "license": "MIT",
    "authors": [
        {
            "name": "Link Robins",
            "email": "karl@linkrobins.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "fof/forum-widgets-core": "^2.0.0-beta.3"
    },
    "autoload": {
        "psr-4": {
            "LinkRobins\\MarkdownWidget\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Link Robins Markdown Widget",
            "category": "forum-widget",
            "icon": {
                "name": "fab fa-markdown",
                "color": "#07adcc",
                "backgroundColor": "#1a2535"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true,
                "backendTesting": true
            }
        }
    },
    "require-dev": {
        "flarum/testing": "^2.0",
        "flarum/phpstan": "^2.0"
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "LinkRobins\\MarkdownWidget\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis.",
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    }
}
